import React from "react"
import { Slot } from "@radix-ui/react-slot"
import { cva, VariantProps } from "class-variance-authority"

import { cn } from "@/lib/utils"

const rainbowButtonVariants = cva(
  cn(
    "group relative inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 overflow-hidden animate-rainbow",
    "rounded-full outline-none transition-all duration-300 focus-visible:ring-2 focus-visible:ring-white/30 focus-visible:ring-offset-0",
    "text-sm font-semibold whitespace-nowrap",
    "disabled:pointer-events-none disabled:opacity-50",
    "[&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 [&_svg]:shrink-0",
    "before:absolute before:-z-20 before:inset-[-38%] before:rounded-[inherit] before:bg-[radial-gradient(circle,rgba(99,102,255,0.32),transparent_65%)] before:bg-[length:320%_320%] before:blur-[55px] before:opacity-70 before:content-[''] before:animate-rainbow",
    "after:absolute after:-z-10 after:inset-[1px] after:rounded-[inherit] after:bg-[rgba(12,12,16,0.95)] after:transition-colors after:duration-300 after:content-['']"
  ),
  {
    variants: {
      variant: {
        default:
          "border-0 text-white bg-[linear-gradient(rgba(13,13,18,0.9),rgba(10,10,15,0.9)),linear-gradient(115deg,var(--color-1),var(--color-5),var(--color-3),var(--color-4),var(--color-2))] bg-[length:100%_100%,320%_320%] [background-clip:padding-box,border-box] [background-origin:border-box] shadow-[0_12px_45px_-24px_rgba(250,204,21,0.55)] after:bg-transparent hover:after:bg-transparent",
        outline:
          "border border-transparent text-white bg-[linear-gradient(#0a0a10,#0a0a10)_padding-box,linear-gradient(115deg,var(--color-1),var(--color-5),var(--color-3),var(--color-4),var(--color-2))_border-box] bg-[length:100%_100%,320%_320%] [background-clip:padding-box,border-box] [background-origin:border-box] shadow-[0_24px_55px_-30px_rgba(56,189,248,0.55)] hover:after:bg-[rgba(17,17,24,0.96)] focus-visible:ring-offset-0",
      },
      size: {
        default: "h-9 px-4 py-2",
        sm: "h-8 px-3 text-xs",
        lg: "h-11 px-8 text-base",
        icon: "size-9",
      },
    },
    defaultVariants: {
      variant: "default",
      size: "default",
    },
  }
)

interface RainbowButtonProps
  extends React.ButtonHTMLAttributes<HTMLButtonElement>,
    VariantProps<typeof rainbowButtonVariants> {
  asChild?: boolean
}

const RainbowButton = React.forwardRef<HTMLButtonElement, RainbowButtonProps>(
  ({ className, variant, size, asChild = false, ...props }, ref) => {
    const Comp = asChild ? Slot : "button"
    return (
      <Comp
        data-slot="button"
        className={cn(rainbowButtonVariants({ variant, size, className }))}
        ref={ref}
        {...props}
      />
    )
  }
)

RainbowButton.displayName = "RainbowButton"

export { RainbowButton, rainbowButtonVariants, type RainbowButtonProps }
